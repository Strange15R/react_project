pipeline {
    agent any

    stages {

        stage('Clean Old Repository') {
            steps {
                echo "Cleaning previous version of the repository"
                sh 'rm -rf react_project/build react_project/node_modules'
            }
        }

        stage('Clone Repository') {
            steps {
                echo "Cloning the repository"
                dir('react_project') {
                    git branch: 'master', url: 'https://github.com/Strange15R/react_project.git'
                    sh 'pwd'
                }
            }
        }

        stage('Install dependencies & Build Application') {
            steps {
                echo 'Building the project'
               dir('react_project') {
                    sh '''
                    npm install
                    DISABLE_ESLINT_PLUGIN=true npm run build
                    ls -ltr
                    '''
               }
            }
        }

        stage('Deploy Build') {
            steps {
                echo "Cleaning & replacing previous build"
                sh '''
                pwd
                ls -la react_project/build
                rm -rf /var/www/html/*
                mv react_project/build/* /var/www/html/
                ls -lah /var/www/html/
                '''
                
            }
        }

        stage('Restart Nginx') {
            steps {
                echo "Restarting Nginx"
                sh 'sudo systemctl restart nginx'
                
            }
        }
    }
}
