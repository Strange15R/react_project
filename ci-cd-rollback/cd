pipeline {
    agent {
        label 'dev'
    }

    stages {

        stage('Pull Latest Image') {
            steps {
                sh 'docker pull strange15r/react-app:latest'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker stop react-app || true'
            }
        }

        stage('Remove Old Container') {
            steps {
                sh 'docker rm react-app || true'
            }
        }

        stage('Run New Container') {
            steps {
                sh 'docker run -d --name react-app -p 90:3000 strange15r/react-app:latest'
            }
        }
    }
}
